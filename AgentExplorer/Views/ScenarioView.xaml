<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AgentExplorer.Views.ScenarioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28,16,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="14" VerticalAlignment="Top" Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon x:Name="HeaderIcon" FontSize="26" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="StepText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <FontIcon Glyph="&#xEA80;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock x:Name="WhatsNewText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" MaxWidth="1000" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="ExtraActionButton" Visibility="Collapsed" Click="ExtraActionButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="ExtraActionIcon" FontSize="14" />
                        <TextBlock x:Name="ExtraActionText" />
                    </StackPanel>
                </Button>
                <Button x:Name="NewConversationButton" Click="NewConversation_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New conversation" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Agent loop pipeline -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,10">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Agent loop" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="IterationText" Text="Idle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="PipelinePanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                </ScrollViewer>
                <TextBlock x:Name="LoopHintText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="360" />
                <ColumnDefinition Width="7*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Conversation -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Padding="16,12,16,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                        <TextBlock Grid.Column="1" Text="Conversation" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Border Grid.Column="2" CornerRadius="10" Padding="10,3" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock x:Name="ModelBadge" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="ChatScroll" Grid.Row="1" Padding="16,0">
                        <Grid>
                            <StackPanel x:Name="ChatPanel" Spacing="10" Padding="0,8,0,12" />
                            <StackPanel x:Name="ChatEmptyState" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0" Opacity="0.75">
                                <FontIcon Glyph="&#xE99A;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Say hello to the agent" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Pick a suggested prompt below or type your own." HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Grid x:Name="StatusBar" Grid.Row="2" Visibility="Collapsed" Padding="16,8" ColumnSpacing="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="StatusRing" Width="18" Height="18" IsActive="False" />
                        <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="Stop" Click="Stop_Click" Padding="10,2" />
                    </Grid>

                    <StackPanel Grid.Row="3" Padding="16,10,16,0" Spacing="6">
                        <TextBlock Text="Try these prompts" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="SuggestionsPanel" Spacing="6" />
                    </StackPanel>

                    <Grid Grid.Row="4" Padding="16,10,16,16" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputBox" PlaceholderText="Message the agent…" KeyDown="InputBox_KeyDown" TextWrapping="Wrap" MaxHeight="120" />
                        <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="Send_Click" VerticalAlignment="Bottom" Height="32" ToolTipService.ToolTip="Send (Enter)">
                            <FontIcon Glyph="&#xE724;" FontSize="14" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Behind the scenes -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <SelectorBar x:Name="Tabs" Margin="8,4,8,0" SelectionChanged="Tabs_SelectionChanged">
                        <SelectorBarItem x:Name="CodeTab" Text="Program.cs" Visibility="Collapsed">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE943;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="ActivityTab" Text="Agent activity (JSON)" IsSelected="True">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE9D9;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="CurtainTab" Text="Behind the curtain">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE8A1;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>

                    <Grid Grid.Row="1">
                        <!-- Code file -->
                        <Grid x:Name="CodePanel" Visibility="Collapsed" Padding="16,8,16,16" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Editable. The agent reads and edits this file only through its tools." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="CaretText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Border Grid.Row="1" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="LineNumbers"
                                            Padding="12,9,8,8"
                                            FontFamily="{StaticResource CodeFontFamily}"
                                            FontSize="13"
                                            TextAlignment="Right"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBox
                                            x:Name="CodeEditor"
                                            Grid.Column="1"
                                            AcceptsReturn="True"
                                            TextWrapping="NoWrap"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False"
                                            FontFamily="{StaticResource CodeFontFamily}"
                                            FontSize="13"
                                            Padding="8,8,8,8"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            VerticalAlignment="Stretch"
                                            TextChanged="CodeEditor_TextChanged"
                                            SelectionChanged="CodeEditor_SelectionChanged" />
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- Agent activity -->
                        <ScrollViewer x:Name="ActivityScroll">
                            <Grid>
                                <StackPanel x:Name="ActivityPanel" Spacing="10" Padding="16,8,16,16" />
                                <StackPanel x:Name="ActivityEmptyState" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,80,24,0" Opacity="0.75" MaxWidth="440">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Nothing sent yet" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Send a message and every loop iteration will show up here: the exact JSON request sent to the LLM, the response, and every tool call." />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- Behind the curtain -->
                        <ScrollViewer x:Name="CurtainPanel" Visibility="Collapsed">
                            <StackPanel x:Name="CurtainContent" Spacing="10" Padding="16,8,16,16" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
